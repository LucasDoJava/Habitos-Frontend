
{
  "name": "habits",
  "options": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["name", "description", "category", "difficulty", "points", "isActive", "createdAt"],
        "properties": {
          "name": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Nome do hábito"
          },
          "description": {
            "bsonType": "string",
            "maxLength": 500,
            "description": "Descrição detalhada do hábito"
          },
          "category": {
            "bsonType": "string",
            "enum": ["saude", "produtividade", "exercicio", "estudo", "social", "outro"],
            "description": "Categoria do hábito"
          },
          "difficulty": {
            "bsonType": "string",
            "enum": ["facil", "medio", "dificil"],
            "description": "Nível de dificuldade"
          },
          "points": {
            "bsonType": "int",
            "minimum": 1,
            "maximum": 100,
            "description": "Pontos ganhos por conclusão"
          },
          "streak": {
            "bsonType": "int",
            "minimum": 0,
            "description": "Sequência atual de dias consecutivos"
          },
          "bestStreak": {
            "bsonType": "int",
            "minimum": 0,
            "description": "Melhor sequência alcançada"
          },
          "totalCompletions": {
            "bsonType": "int",
            "minimum": 0,
            "description": "Total de conclusões"
          },
          "isActive": {
            "bsonType": "bool",
            "description": "Se o hábito está ativo"
          },
          "icon": {
            "bsonType": "string",
            "description": "Ícone do hábito"
          },
          "color": {
            "bsonType": "string",
            "description": "Cor associada ao hábito"
          },
          "createdAt": {
            "bsonType": "string",
            "title": "datetime",
            "description": "Data de criação"
          },
          "updatedAt": {
            "bsonType": "string",
            "title": "datetime",
            "description": "Data de atualização"
          }
        },
        "additionalProperties": true
      }
    },
    "validationLevel": "moderate",
    "validationAction": "warn"
  }
}
